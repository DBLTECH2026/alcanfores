# Copiar como deploy/.env en el servidor y reemplazar TODOS los valores (nunca subir .env al repositorio).
# Generar secretos con:  openssl rand -base64 48
VERSION=local
FRONT_URL=https://alcanfores.dbltech.tech
PUBLIC_API_URL=https://alcanfores.dbltech.tech

MYSQL_ROOT_CLAVE=cambiar
DB_CLAVE_AUTH=cambiar
DB_CLAVE_CATALOGO=cambiar
DB_CLAVE_RESERVAS=cambiar
DB_CLAVE_PAGOS=cambiar
DB_CLAVE_NOTIFICACIONES=cambiar
# Base de Canchita (alcanfores_asistente, usuario asistente_svc): desplegar.sh la crea si falta.
ASISTENTE_DB_CLAVE=cambiar

RABBIT_USUARIO=alcanfores
RABBIT_CLAVE=cambiar

JWT_SECRETO=cambiar-por-un-secreto-de-al-menos-32-bytes
INTERNO_TOKEN=cambiar
PASARELA_BETA_SECRETO=cambiar

# Claves de las cuentas de demostración del panel
SEED_CLAVE_ADMIN=cambiar
SEED_CLAVE_RECEPCION=cambiar
SEED_CLAVE_DOCENTE=cambiar

# Integraciones opcionales (vacías = modo simulado)
FACTILIZA_TOKEN=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRETO=
MAIL_HOST=
MAIL_PORT=587
MAIL_USUARIO=
MAIL_CLAVE=
MAIL_REMITENTE=
EVOLUTION_URL=
EVOLUTION_APIKEY=
EVOLUTION_INSTANCIA=alcanfores
# Llave para cifrar la contraseña del correo que se guarda desde el panel (vacía = se deriva de JWT_SECRETO).
# Si se cambia, hay que volver a escribir la contraseña del correo en el panel.
CORREO_CLAVE_CIFRADO=
# SOLO pruebas locales/E2E: devuelve el código de «recuperar contraseña» en la respuesta. Dejar VACÍO en producción.
RECUPERAR_DEVOLVER_CODIGO=

# Canchita (asistente con IA). Credencial: token de la suscripción de Claude (claude setup-token → sk-ant-oat01-…).
# Se carga en el servidor con deploy/poner-llave-ia.sh (lee el token por la entrada estándar, sin mostrarlo).
# Vacía = Canchita responde un texto fijo con el enlace al portal y el WhatsApp del equipo.
CLAUDE_CODE_OAUTH_TOKEN=
# Alternativa opcional: llave de la API de Anthropic (sk-ant-api…), solo si no hay token de suscripción.
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5
IA_ESFUERZO=low
# Opcional: token del webhook de Evolution hacia Canchita (vacío = se deriva de INTERNO_TOKEN).
ASISTENTE_WEBHOOK_TOKEN=
