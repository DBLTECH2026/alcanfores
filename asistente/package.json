{
  "name": "asistente-service",
  "version": "1.0.0",
  "private": true,
  "description": "Canchita: asistente con IA de Alcanfores (WhatsApp + web) sobre el SDK de agentes de Claude",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
